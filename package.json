    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "brittle": "^3.19.1",
    "lunte": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "suspend-resource": "^1.0.0"
